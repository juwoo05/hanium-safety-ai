AWS_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY를 채우면 그 값을 우선 사용한다(config.py).
# 둘 다 비우면 AWS_PROFILE로 로컬 aws configure 프로필을 찾는다.
AWS_PROFILE=hanium-safety-ai
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# on-demand invoke 가능한 모델 (claude-3-5-sonnet-20241022-v2:0 등 최신 버전은 INFERENCE_PROFILE 전용이라 여기선 사용 불가)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
KNOWLEDGE_BASE_ID=
# Cohere Rerank 3.5가 AWS_REGION(ap-northeast-2)에 없어 별도 리전 사용 (rerank 호출만 여기로 감)
RERANK_REGION=ap-northeast-1
# 비워두면 config.py 기본값이 아니라 "빈 문자열"이 그대로 쓰여서 Bedrock rerank가
# "modelArn 길이 0" 에러로 실패한다(2026-07-30에 실제로 겪음). 반드시 값을 채울 것.
RERANK_MODEL_ARN=arn:aws:bedrock:ap-northeast-1::foundation-model/cohere.rerank-v3-5:0
OPENSEARCH_ENDPOINT=
S3_BUCKET_NAME=hanium-safety-ai
SNS_TOPIC_ARN=
SPRING_BOOT_BASE_URL=http://localhost:8080
INTERNAL_API_KEY=
