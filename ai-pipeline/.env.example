AWS_REGION=ap-northeast-2
# 로컬 개발 시 다른 프로젝트의 기본(default) 자격증명을 실수로 쓰지 않도록,
# `aws configure --profile hanium-safety-ai`로 이 프로젝트 전용 프로필을 만들고 여기에 지정한다.
AWS_PROFILE=hanium-safety-ai
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# on-demand invoke 가능한 모델 (claude-3-5-sonnet-20241022-v2:0 등 최신 버전은 INFERENCE_PROFILE 전용이라 여기선 사용 불가)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
KNOWLEDGE_BASE_ID=
# Cohere Rerank 3.5가 AWS_REGION(ap-northeast-2)에 없어 별도 리전 사용 (rerank 호출만 여기로 감)
RERANK_REGION=ap-northeast-1
RERANK_MODEL_ARN=
OPENSEARCH_ENDPOINT=
S3_BUCKET_NAME=hanium-safety-ai
SNS_TOPIC_ARN=
SPRING_BOOT_BASE_URL=http://localhost:8080
INTERNAL_API_KEY=
